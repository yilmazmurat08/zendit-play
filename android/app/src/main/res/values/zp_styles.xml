<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native player controls (layout/zendit_player.xml). -->
    <style name="ZpIconButton">
        <item name="android:background">@drawable/zp_icon_button_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="tint">@color/zp_text</item>
    </style>

    <style name="ZpPlayButton" parent="ZpIconButton">
        <item name="android:background">@drawable/zp_play_button_bg</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_marginStart">36dp</item>
        <item name="android:layout_marginEnd">36dp</item>
    </style>

    <style name="ZpRoundButton" parent="ZpIconButton">
        <item name="android:background">@drawable/zp_round_button_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginStart">0dp</item>
    </style>

    <style name="ZpChip">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/zp_text</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/zp_chip_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:drawableTint">@color/zp_text</item>
    </style>

    <style name="ZpEpgBadge">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="ZpEpgText">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="ZpPanelText">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/zp_text</item>
    </style>
</resources>
