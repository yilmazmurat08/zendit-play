<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/zp_row_bg"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/zp_row_muted"
        android:id="@+id/zp_row_number"
        android:duplicateParentState="true"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"/>
    <LinearLayout
        android:orientation="vertical"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/zp_text"
            android:ellipsize="end"
            android:id="@+id/zp_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/zp_row_muted"
            android:ellipsize="end"
            android:id="@+id/zp_row_subtitle"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"/>
        <ProgressBar
            android:id="@+id/zp_row_progress"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:max="100"
            android:progressTint="@color/zp_row_accent"
            android:progressBackgroundTint="@color/zp_track"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/zp_row_check"
        android:duplicateParentState="true"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/zp_ic_check"
        android:importantForAccessibility="no"
        android:layout_marginStart="10dp"
        app:tint="@color/zp_row_accent"/>
</LinearLayout>
