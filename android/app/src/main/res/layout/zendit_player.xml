<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/zp_root"
    android:background="@android:color/black"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <androidx.media3.ui.AspectRatioFrameLayout
        android:layout_gravity="center"
        android:id="@+id/zp_video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <SurfaceView
            android:id="@+id/zp_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.media3.ui.AspectRatioFrameLayout>
    <androidx.media3.ui.SubtitleView
        android:id="@+id/zp_subtitles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/zp_touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/zp_buffering"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/zp_brand"/>
    <FrameLayout
        android:id="@+id/zp_controls"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="top"
            android:background="@drawable/zp_scrim_top"
            android:layout_width="match_parent"
            android:layout_height="170dp"/>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/zp_scrim_bottom"
            android:layout_width="match_parent"
            android:layout_height="320dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:id="@+id/zp_top_bar"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageButton
                android:id="@+id/zp_back"
                android:src="@drawable/zp_ic_back"
                android:contentDescription="Geri"
                android:layout_marginStart="0dp"
                style="@style/ZpIconButton"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/zp_text"
                    android:ellipsize="end"
                    android:id="@+id/zp_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/zp_muted"
                    android:ellipsize="end"
                    android:id="@+id/zp_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"/>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/zp_text"
                android:id="@+id/zp_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFeatureSettings="tnum"/>
            <ImageButton
                android:id="@+id/zp_list"
                android:src="@drawable/zp_ic_list"
                android:contentDescription="Kanal listesi"
                style="@style/ZpIconButton"/>
            <ImageButton
                android:id="@+id/zp_info_button"
                android:src="@drawable/zp_ic_info"
                android:contentDescription="Yayın bilgisi"
                style="@style/ZpIconButton"/>
            <ImageButton
                android:id="@+id/zp_pip"
                android:src="@drawable/zp_ic_pip"
                android:contentDescription="Küçük pencere"
                style="@style/ZpIconButton"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/zp_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/zp_left"
                android:src="@drawable/zp_ic_replay"
                android:contentDescription="10 saniye geri"
                style="@style/ZpRoundButton"/>
            <ImageButton
                android:id="@+id/zp_play"
                android:src="@drawable/zp_ic_pause"
                android:contentDescription="Oynat / duraklat"
                style="@style/ZpPlayButton"/>
            <ImageButton
                android:id="@+id/zp_right"
                android:src="@drawable/zp_ic_forward"
                android:contentDescription="10 saniye ileri"
                style="@style/ZpRoundButton"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/zp_bottom_bar"
            android:paddingBottom="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/zp_epg_row"
                android:background="@drawable/zp_epg_card"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="18dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/zp_live_badge"
                        android:background="@drawable/zp_live_badge"
                        android:text="CANLI"
                        style="@style/ZpEpgBadge"/>
                    <TextView
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:id="@+id/zp_now"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        style="@style/ZpEpgText"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/zp_epg_accent"
                        android:id="@+id/zp_now_left"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="14dp"
                        android:fontFeatureSettings="tnum"
                        style="@style/ZpEpgText"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/zp_epg_secondary"
                    android:id="@+id/zp_now_desc"
                    android:layout_width="match_parent"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="76dp"
                    style="@style/ZpEpgText"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/zp_next_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:background="@drawable/zp_next_badge"
                        android:text="SONRA"
                        style="@style/ZpEpgBadge"/>
                    <TextView
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:id="@+id/zp_next_time"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFeatureSettings="tnum"
                        style="@style/ZpEpgText"/>
                    <TextView
                        android:textSize="17sp"
                        android:textColor="@color/zp_epg_secondary"
                        android:id="@+id/zp_next"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        style="@style/ZpEpgText"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/zp_seek_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/zp_text"
                    android:id="@+id/zp_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:fontFeatureSettings="tnum"/>
                <SeekBar
                    android:id="@+id/zp_seek"
                    android:background="@drawable/zp_seek_bg"
                    android:focusable="true"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:maxHeight="6dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/zp_seek_track"
                    android:minHeight="6dp"
                    android:thumb="@drawable/zp_seek_thumb"
                    android:layout_weight="1"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:splitTrack="false"/>
                <ProgressBar
                    android:id="@+id/zp_epg_progress"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/zp_seek_track"
                    android:layout_weight="1"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/zp_text"
                    android:gravity="end"
                    android:id="@+id/zp_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="52dp"
                    android:fontFeatureSettings="tnum"/>
            </LinearLayout>
            <HorizontalScrollView
                android:id="@+id/zp_tools_scroll"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/zp_tools"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/zp_tool_live"
                        android:visibility="gone"
                        android:text="Canlıya dön"
                        android:drawableStart="@drawable/zp_ic_skip_next"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_audio"
                        android:text="Ses"
                        android:drawableStart="@drawable/zp_ic_audio"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_subtitles"
                        android:text="Altyazı"
                        android:drawableStart="@drawable/zp_ic_subtitles"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_quality"
                        android:text="Kalite"
                        android:drawableStart="@drawable/zp_ic_hd"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_aspect"
                        android:text="Sığdır"
                        android:drawableStart="@drawable/zp_ic_aspect"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_speed"
                        android:text="Hız 1x"
                        android:drawableStart="@drawable/zp_ic_speed"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_episodes"
                        android:text="Bölümler"
                        android:drawableStart="@drawable/zp_ic_list"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_restart"
                        android:text="Baştan başlat"
                        android:drawableStart="@drawable/zp_ic_replay"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_sleep"
                        android:text="Uyku"
                        android:drawableStart="@drawable/zp_ic_moon"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_lock"
                        android:text="Kilitle"
                        android:drawableStart="@drawable/zp_ic_lock"
                        style="@style/ZpChip"/>
                    <TextView
                        android:id="@+id/zp_tool_external"
                        android:text="Harici oynatıcı"
                        android:drawableStart="@drawable/zp_ic_external"
                        style="@style/ZpChip"/>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/zp_gesture_panel"
        android:background="@drawable/zp_panel_bg"
        android:paddingTop="18dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="168dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:id="@+id/zp_gesture_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/zp_ic_volume"
            android:importantForAccessibility="no"
            app:tint="@color/zp_text"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/zp_text"
            android:id="@+id/zp_gesture_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFeatureSettings="tnum"/>
        <ProgressBar
            android:id="@+id/zp_gesture_level"
            android:layout_width="128dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progressTint="@color/zp_brand"
            android:progressBackgroundTint="@color/zp_track"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/zp_text"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/zp_hint"
        android:background="@drawable/zp_panel_bg"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <TextView
        android:textSize="44sp"
        android:textStyle="bold"
        android:textColor="@color/zp_text"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/zp_number"
        android:background="@drawable/zp_panel_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:minWidth="96dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:layout_marginEnd="40dp"
        android:fontFeatureSettings="tnum"/>
    <TextView
        android:textSize="13sp"
        android:typeface="monospace"
        android:textColor="@color/zp_text"
        android:layout_gravity="start|top"
        android:id="@+id/zp_info"
        android:background="@drawable/zp_panel_bg"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <ImageButton
        android:layout_gravity="start|center_vertical"
        android:id="@+id/zp_unlock"
        android:visibility="gone"
        android:src="@drawable/zp_ic_lock"
        android:contentDescription="Kilidi aç"
        android:layout_marginStart="28dp"
        style="@style/ZpRoundButton"/>
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/zp_next_card"
        android:background="@drawable/zp_panel_bg"
        android:padding="18dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/zp_muted"
            android:id="@+id/zp_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/zp_text"
            android:ellipsize="end"
            android:id="@+id/zp_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="340dp"
            android:maxLines="2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:id="@+id/zp_next_play"
                android:text="Şimdi oynat"
                android:drawableStart="@drawable/zp_ic_play"
                style="@style/ZpChip"/>
            <TextView
                android:id="@+id/zp_next_cancel"
                android:text="İptal"
                android:layout_marginEnd="0dp"
                style="@style/ZpChip"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/zp_error"
        android:background="@drawable/zp_panel_bg"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/zp_ic_error"
            android:importantForAccessibility="no"
            app:tint="@color/zp_brand"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/zp_text"
            android:gravity="center"
            android:id="@+id/zp_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxWidth="480dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/zp_muted"
            android:gravity="center"
            android:id="@+id/zp_error_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxWidth="480dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <TextView
                android:id="@+id/zp_error_retry"
                android:text="Tekrar dene"
                android:drawableStart="@drawable/zp_ic_refresh"
                style="@style/ZpChip"/>
            <TextView
                android:id="@+id/zp_error_external"
                android:text="Harici oynatıcı"
                android:drawableStart="@drawable/zp_ic_external"
                style="@style/ZpChip"/>
            <TextView
                android:id="@+id/zp_error_close"
                android:text="Kapat"
                android:layout_marginEnd="0dp"
                style="@style/ZpChip"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/zp_side_scrim"
        android:background="#73000000"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:id="@+id/zp_side_panel"
        android:background="@drawable/zp_side_bg"
        android:paddingTop="20dp"
        android:visibility="gone"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:elevation="8dp">
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/zp_text"
            android:id="@+id/zp_side_title"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/zp_side_list"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
